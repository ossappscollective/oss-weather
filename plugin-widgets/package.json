{
    "name": "plugin-widgets",
    "main": "src/index",
    "typings": "src/index.d.ts",
    "nativescript": {
        "platforms": {
            "ios": "6.2.1",
            "android": "6.2.1"
        }
    },
    "version": "1.0.0",
    "description": "OSS-Weather widgets plugin",
    "types": "module",
    "scripts": {
        "generate:all": "npm run generate:kind-configs && npm run generate:ns && npm run generate:glance && npm run generate:swift",
        "generate:swift": "tsx scripts/generators/swift-generator.ts",
        "generate:glance": "tsx scripts/generators/glance-generator.ts",
        "generate:ns": "tsx scripts/generators/nativescript-svelte-generator.ts",
        "generate:kind-configs": "tsx scripts/generators/generate-widget-kind-configs.ts",
        "dev": "vite"
    },
    "dependencies": {
        "@nativescript-community/ui-image": "4.6.14",
        "ts-node": "^10.9.2"
    },
    "devDependencies": {
        "@types/node": "^24.10.3",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    }
}
