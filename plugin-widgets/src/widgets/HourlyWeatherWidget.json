{
    "$schema": "../../schema.json",
    "name": "HourlyWeatherWidget",
    "displayName": "Hourly Forecast",
    "description": "Shows hourly weather forecast with icons and temperatures",
    "defaultPadding": 0,
    "color": ["case", ["==", ["get", "config.settings.color"], null], "color.onSurface", ["get", "config.settings.color"]],
    "layout": {
        "type": "conditional",
        "condition": [">=", ["get", "size.height"], 160],
        "then": {
            "type": "column",
            "children": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "label",
                            "text": ["get", "locationName"],
                            "fontSize": 13,
                            "maxLines": 1,
                            "fontWeight": "medium",
                            "flex": 1
                        },
                        { "type": "label", "text": ["get", "temperature"], "fontSize": 13, "maxLines": 1 },
                        { "type": "spacer", "size": 4, "direction": "horizontal" },
                        {
                            "type": "label",
                            "text": ["get", "description"],
                            "fontSize": 12,
                            "maxLines": 1,
                            "opacity": 0.6
                        }
                    ],
                    "fillWidth": true,
                    "crossAlignment": "center",
                    "paddingHorizontal": 8,
                    "paddingBottom": 4
                },
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "forEach",
                            "items": "hourlyData",
                            "limit": [
                                "case",
                                [">=", ["get", "size.width"], 400],
                                7,
                                [">=", ["get", "size.width"], 330],
                                6,
                                [">=", ["get", "size.width"], 260],
                                5,
                                4
                            ],
                            "itemTemplate": {
                                "type": "column",
                                "children": [
                                    {
                                        "type": "label",
                                        "text": ["get", "item.hour"],
                                        "fontSize": 12,
                                        "maxLines": 1,
                                        "fontWeight": "medium"
                                    },
                                    { "type": "spacer", "size": 2 },
                                    { "type": "image", "src": ["get", "item.iconPath"], "size": 22 },
                                    { "type": "spacer", "size": 2 },
                                    {
                                        "type": "row",
                                        "children": [
                                            {
                                                "type": "image",
                                                "src": ["get", "item.wind.iconPath"],
                                                "size": 11,
                                                "visibleIf": ["has", "item.wind.iconPath"]
                                            },
                                            { "type": "spacer", "size": 2, "direction": "horizontal" },
                                            { "type": "label", "text": ["get", "item.wind.value"], "fontSize": 11, "maxLines": 1 }
                                        ],
                                        "crossAlignment": "center"
                                    }
                                ],
                                "flex": 1,
                                "crossAlignment": "center"
                            }
                        }
                    ],
                    "fillWidth": true
                },
                {
                    "type": "hourlyChart",
                    "items": "hourlyData",
                    "limit": ["case", [">=", ["get", "size.width"], 400], 7, [">=", ["get", "size.width"], 330], 6, [">=", ["get", "size.width"], 260], 5, 4],
                    "fontSize": 13,
                    "height": ["max", ["-", ["get", "size.height"], 96], 60],
                    "fillWidth": true
                }
            ],
            "fillMaxSize": true,
            "paddingHorizontal": 6,
            "paddingVertical": 10
        },
        "else": {
            "type": "column",
            "children": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "label",
                            "text": ["get", "locationName"],
                            "fontSize": 13,
                            "maxLines": 1,
                            "fontWeight": "medium",
                            "flex": 1
                        },
                        { "type": "label", "text": ["get", "temperature"], "fontSize": 13, "maxLines": 1 },
                        { "type": "spacer", "size": 4, "direction": "horizontal" },
                        {
                            "type": "label",
                            "text": ["get", "description"],
                            "fontSize": 12,
                            "maxLines": 1,
                            "opacity": 0.6
                        }
                    ],
                    "fillWidth": true,
                    "crossAlignment": "center",
                    "paddingHorizontal": 8,
                    "paddingBottom": 4
                },
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "forEach",
                            "items": "hourlyData",
                            "limit": [
                                "case",
                                [">=", ["get", "size.width"], 400],
                                7,
                                [">=", ["get", "size.width"], 330],
                                6,
                                [">=", ["get", "size.width"], 260],
                                5,
                                4
                            ],
                            "itemTemplate": {
                                "type": "column",
                                "children": [
                                    {
                                        "type": "label",
                                        "text": ["get", "item.hour"],
                                        "fontSize": 12,
                                        "maxLines": 1,
                                        "fontWeight": "medium"
                                    },
                                    { "type": "spacer", "size": 2 },
                                    { "type": "image", "src": ["get", "item.iconPath"], "size": 22 },
                                    { "type": "spacer", "size": 2 },
                                    {
                                        "type": "label",
                                        "text": ["get", "item.temperature"],
                                        "fontSize": 13,
                                        "maxLines": 1,
                                        "fontWeight": "medium"
                                    }
                                ],
                                "flex": 1,
                                "crossAlignment": "center"
                            }
                        }
                    ],
                    "fillWidth": true
                }
            ],
            "fillMaxSize": true,
            "paddingHorizontal": 6,
            "paddingVertical": 8
        }
    },
    "generatePreviews": true,
    "preview": {
        "sizes": [{"width": 360, "height": 200}, {"width": 260, "height": 170}, {"width": 300, "height": 100}],
        "fakeData": {
            "temperature": "12 °C",
            "locationName": "Paris",
            "description": "Partly Cloudy",
            "date": "Mon, Feb 24",
            "hourlyData": [
                {
                    "time": "06:00",
                    "temperature": "6 °C",
                    "iconPath": 800,
                    "precipAccumulation": "0 mm",
                    "windSpeed": "10 km/h"
                },
                {
                    "time": "07:00",
                    "temperature": "7 °C",
                    "iconPath": 800,
                    "precipAccumulation": "0 mm",
                    "windSpeed": "10 km/h"
                },
                {
                    "time": "08:00",
                    "temperature": "8 °C",
                    "iconPath": 802,
                    "precipAccumulation": "0 mm",
                    "windSpeed": "12 km/h"
                },
                {
                    "time": "09:00",
                    "temperature": "10 °C",
                    "iconPath": 500,
                    "precipAccumulation": "0 mm",
                    "windSpeed": "12 km/h"
                },
                {
                    "time": "10:00",
                    "temperature": "12 °C",
                    "iconPath": 802,
                    "precipAccumulation": "0 mm",
                    "windSpeed": "14 km/h"
                },
                {
                    "time": "11:00",
                    "temperature": "13 °C",
                    "iconPath": 802,
                    "precipAccumulation": "0 mm",
                    "windSpeed": "14 km/h"
                },
                {
                    "time": "12:00",
                    "temperature": "14 °C",
                    "iconPath": 500,
                    "precipAccumulation": "0.2 mm",
                    "windSpeed": "16 km/h"
                },
                {
                    "time": "13:00",
                    "temperature": "14 °C",
                    "iconPath": 500,
                    "precipAccumulation": "0.5 mm",
                    "windSpeed": "16 km/h"
                }
            ]
        }
    }
}
