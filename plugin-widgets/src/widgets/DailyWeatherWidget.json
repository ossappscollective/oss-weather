{
    "$schema": "../../schema.json",
    "name": "DailyWeatherWidget",
    "displayName": "Daily Forecast",
    "description": "Shows daily weather forecast with high/low temperatures",
    "defaultPadding": 0,
    "color": ["case", ["==", ["get", "config.settings.color"], null], "color.onSurface", ["get", "config.settings.color"]],
    "layout": {
        "type": "conditional",
        "condition": ["all", [">=", ["get", "size.width"], 250], ["<", ["get", "size.height"], 170]],
        "then": {
            "type": "column",
            "children": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "label",
                            "text": ["get", "locationName"],
                            "fontSize": 13,
                            "maxLines": 1,
                            "fontWeight": "medium",
                            "flex": 1
                        },
                        { "type": "label", "text": ["get", "temperature"], "fontSize": 13, "maxLines": 1 },
                        { "type": "spacer", "size": 4, "direction": "horizontal" },
                        {
                            "type": "label",
                            "text": ["get", "description"],
                            "fontSize": 12,
                            "maxLines": 1,
                            "opacity": 0.6
                        }
                    ],
                    "fillWidth": true,
                    "crossAlignment": "center",
                    "paddingBottom": 6
                },
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "forEach",
                            "items": "dailyData",
                            "limit": ["case", [">=", ["get", "size.width"], 340], 5, 4],
                            "itemTemplate": {
                                "type": "column",
                                "children": [
                                    {
                                        "type": "label",
                                        "text": ["get", "item.day"],
                                        "fontSize": 13,
                                        "maxLines": 1,
                                        "fontWeight": "medium"
                                    },
                                    { "type": "spacer", "size": 2 },
                                    { "type": "image", "src": ["get", "item.iconPath"], "size": 26 },
                                    { "type": "spacer", "size": 2 },
                                    {
                                        "type": "row",
                                        "children": [
                                            {
                                                "type": "label",
                                                "text": ["get", "item.temperatureLow"],
                                                "fontSize": 13,
                                                "maxLines": 1,
                                                "opacity": 0.6
                                            },
                                            { "type": "spacer", "size": 4, "direction": "horizontal" },
                                            {
                                                "type": "label",
                                                "text": ["get", "item.temperatureHigh"],
                                                "fontSize": 13,
                                                "maxLines": 1,
                                                "fontWeight": "medium"
                                            }
                                        ],
                                        "crossAlignment": "center"
                                    },
                                    { "type": "spacer", "size": 3 },
                                    {
                                        "type": "conditional",
                                        "condition": ["!=", ["get", "config.settings.showChips"], false],
                                        "then": {
                                            "type": "chips",
                                            "items": "item.precipChips",
                                            "limit": 1,
                                            "fontSize": 11,
                                            "iconSize": 11,
                                            "maxWidth": ["/", ["-", ["get", "size.width"], 24], ["case", [">=", ["get", "size.width"], 340], 5, 4]]
                                        },
                                        "else": { "type": "column", "children": [] }
                                    }
                                ],
                                "flex": 1,
                                "crossAlignment": "center"
                            }
                        }
                    ],
                    "fillWidth": true
                }
            ],
            "fillMaxSize": true,
            "paddingHorizontal": 12,
            "paddingVertical": 10
        },
        "else": {
            "type": "column",
            "children": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "label",
                            "text": ["get", "locationName"],
                            "fontSize": 13,
                            "maxLines": 1,
                            "fontWeight": "medium",
                            "flex": 1
                        },
                        { "type": "label", "text": ["get", "temperature"], "fontSize": 13, "maxLines": 1 },
                        { "type": "spacer", "size": 4, "direction": "horizontal" },
                        {
                            "type": "label",
                            "text": ["get", "description"],
                            "fontSize": 12,
                            "maxLines": 1,
                            "opacity": 0.6
                        }
                    ],
                    "fillWidth": true,
                    "crossAlignment": "center",
                    "paddingBottom": 6
                },
                {
                    "type": "forEach",
                    "items": "dailyData",
                    "limit": [
                        "case",
                        [">=", ["get", "size.height"], 394],
                        8,
                        [">=", ["get", "size.height"], 351],
                        7,
                        [">=", ["get", "size.height"], 308],
                        6,
                        [">=", ["get", "size.height"], 265],
                        5,
                        [">=", ["get", "size.height"], 222],
                        4,
                        [">=", ["get", "size.height"], 179],
                        3,
                        2
                    ],
                    "itemTemplate": { "type": "template", "name": "dailyRow" }
                }
            ],
            "fillMaxSize": true,
            "paddingHorizontal": 14,
            "paddingVertical": 10
        }
    },
    "generatePreviews": true,
    "preview": {
        "sizes": [{"width": 340, "height": 300}, {"width": 320, "height": 150}, {"width": 180, "height": 300}],
        "fakeData": {
            "temperature": "12°",
            "description": "Partly Cloudy",
            "iconPath": 802,
            "locationName": "Grenoble",
            "date": "Mon, Feb 24",
            "dailyData": [
                {
                    "day": "Mon",
                    "iconPath": 800,
                    "temperatureHigh": "12°",
                    "temperatureLow": "4°",
                    "precipAccumulation": "0 mm",
                    "precipitation": "5 %",
                    "windSpeed": "14 km/h"
                },
                {
                    "day": "Tue",
                    "iconPath": 802,
                    "temperatureHigh": "14°",
                    "temperatureLow": "6°",
                    "precipAccumulation": "0 mm",
                    "precipitation": "10 %",
                    "windSpeed": "12 km/h"
                },
                {
                    "day": "Wed",
                    "iconPath": 500,
                    "temperatureHigh": "10°",
                    "temperatureLow": "5°",
                    "precipAccumulation": "3 mm",
                    "precipitation": "60 %",
                    "windSpeed": "18 km/h"
                },
                {
                    "day": "Thu",
                    "iconPath": 502,
                    "temperatureHigh": "9°",
                    "temperatureLow": "3°",
                    "precipAccumulation": "8 mm",
                    "precipitation": "80 %",
                    "windSpeed": "22 km/h"
                },
                {
                    "day": "Fri",
                    "iconPath": 802,
                    "temperatureHigh": "11°",
                    "temperatureLow": "4°",
                    "precipAccumulation": "0 mm",
                    "precipitation": "20 %",
                    "windSpeed": "16 km/h"
                },
                {
                    "day": "Sat",
                    "iconPath": 800,
                    "temperatureHigh": "15°",
                    "temperatureLow": "7°",
                    "precipAccumulation": "0 mm",
                    "precipitation": "5 %",
                    "windSpeed": "10 km/h"
                }
            ]
        }
    },
    "settings": {
        "showChips": { "type": "boolean", "default": true, "title": "widget_show_chips" }
    }
}
