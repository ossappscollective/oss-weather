                                                    1.3
                                                ],
                                                "visibleIf": ["has", "iconPath"]
                                            },
                                            {
                                                "type": "label",
                                                "text": ["get", "temperature"],
                                                "fontSize": ["min", ["*", ["get", "size.width"], 0.1], ["min", ["*", ["get", "size.height"], 0.18], 36]],
                                                "maxLines": 1,
                                                "fontWeight": "light"
                                            }
                                        ],
                                        "crossAlignment": "end"
                                    }
                                ],
                                "fillWidth": true,
                                "crossAlignment": "start"
                            },
                            { "type": "spacer", "size": 6 },
                            {
                                "type": "row",
                                "children": [
                                    {
                                        "type": "label",
                                        "text": ["concat", ["get", "locationName"], " · ", ["get", "description"]],
                                        "fontSize": ["max", ["min", ["*", ["get", "size.width"], 0.045], ["min", ["*", ["get", "size.height"], 0.08], 15]], 11],
                                        "maxLines": 1,
                                        "opacity": 0.6,
                                        "flex": 1
                                    },
                                    {
                                        "type": "row",
                                        "children": [
                                            {
                                                "type": "label",
                                                "text": ["get", "temperatureLow"],
                                                "fontSize": [
                                                    "max",
                                                    ["min", ["*", ["get", "size.width"], 0.045], ["min", ["*", ["get", "size.height"], 0.08], 15]],
                                                    11
                                                ],
                                                "maxLines": 1,
                                                "opacity": 0.6
                                            },
                                            { "type": "spacer", "size": 4, "direction": "horizontal" },
                                            {
                                                "type": "label",
                                                "text": ["get", "temperatureHigh"],
                                                "fontSize": [
                                                    "max",
                                                    ["min", ["*", ["get", "size.width"], 0.045], ["min", ["*", ["get", "size.height"], 0.08], 15]],
                                                    11
                                                ],
                                                "maxLines": 1,
                                                "fontWeight": "medium"
                                            }
                                        ],
                                        "crossAlignment": "center"
                                    }
                                ],
                                "fillWidth": true,
                                "crossAlignment": "center"
                            },
                            { "type": "spacer", "size": 10 },
                            {
                                "type": "conditional",
                                "condition": ["all", ["==", ["get", "config.settings.showHourly"], true], [">=", ["get", "size.height"], 300]],
                                "then": {
                                    "type": "column",
                                    "children": [{"type": "template", "name": "hourlySection"}, {"type": "spacer", "size": 8}],
                                    "fillWidth": true
                                },
                                "else": { "type": "column", "children": [], "fillWidth": true }
                            },
                            {
                                "type": "forEach",
                                "items": "dailyData",
                                "limit": [
                                    "case",
                                    ["all", ["==", ["get", "config.settings.showHourly"], true], [">=", ["get", "size.height"], 300]],
                                    [
                                        "case",
                                        [">=", ["get", "size.height"], 500],
                                        4,
                                        [">=", ["get", "size.height"], 457],
                                        3,
                                        [">=", ["get", "size.height"], 414],
                                        2,
                                        [">=", ["get", "size.height"], 371],
                                        1,
                                        0
                                    ],
                                    [
                                        "case",
                                        [">=", ["get", "size.height"], 455],
                                        6,
                                        [">=", ["get", "size.height"], 412],
                                        5,
                                        [">=", ["get", "size.height"], 369],
                                        4,
                                        [">=", ["get", "size.height"], 326],
                                        3,
                                        [">=", ["get", "size.height"], 283],
                                        2,
                                        [">=", ["get", "size.height"], 240],
                                        1,
                                        0
                                    ]
                                ],
                                "itemTemplate": { "type": "template", "name": "dailyRow" }
                            }
                        ],
                        "fillMaxSize": true,
                        "padding": 18
                    },
                    "else": {
                        "type": "row",
                        "children": [
                            {
                                "type": "column",
                                "children": [
                                    {
                                        "type": "clock",
                                        "fontSize": [
                                            "max",
                                            ["min", ["/", ["-", ["get", "size.width"], 128], 4.1], ["min", ["*", ["get", "size.height"], 0.42], 60]],
                                            9
                                        ],
                                        "fontWeight": ["case", ["==", ["get", "config.settings.clockBold"], true], "bold", "light"],
                                        "maxLines": 1
                                    },
                                    {
                                        "type": "date",
                                        "style": "fullDate",
                                        "fontSize": ["max", ["min", ["*", ["get", "size.width"], 0.05], ["min", ["*", ["get", "size.height"], 0.13], 13]], 10],
                                        "maxLines": 1,
                                        "opacity": 0.6
                                    }
                                ],
                                "flex": 1
                            },
                            {
                                "type": "column",
                                "children": [
                                    {
                                        "type": "row",
                                        "children": [
                                            {
                                                "type": "image",
                                                "src": ["get", "iconPath"],
                                                "size": [
                                                    "*",
                                                    ["min", ["*", ["get", "size.width"], 0.1], ["min", ["*", ["get", "size.height"], 0.28], 32]],
                                                    1.3
                                                ],
                                                "visibleIf": ["has", "iconPath"]
                                            },
                                            { "type": "spacer", "size": 4, "direction": "horizontal" },
                                            {
                                                "type": "label",
                                                "text": ["get", "temperature"],
                                                "fontSize": ["min", ["*", ["get", "size.width"], 0.1], ["min", ["*", ["get", "size.height"], 0.25], 28]],
                                                "maxLines": 1,
                                                "fontWeight": "light"
                                            }
                                        ],
                                        "crossAlignment": "center"
                                    },
                                    {
                                        "type": "row",
                                        "children": [
                                            {
                                                "type": "label",
                                                "text": ["get", "temperatureLow"],
                                                "fontSize": [
                                                    "max",
                                                    ["min", ["*", ["get", "size.width"], 0.045], ["min", ["*", ["get", "size.height"], 0.12], 13]],
                                                    10
                                                ],
                                                "maxLines": 1,
                                                "opacity": 0.6
                                            },
                                            { "type": "spacer", "size": 4, "direction": "horizontal" },
                                            {
                                                "type": "label",
                                                "text": ["get", "temperatureHigh"],
                                                "fontSize": [
                                                    "max",
                                                    ["min", ["*", ["get", "size.width"], 0.045], ["min", ["*", ["get", "size.height"], 0.12], 13]],
                                                    10
                                                ],
                                                "maxLines": 1,
                                                "fontWeight": "medium"
                                            }
