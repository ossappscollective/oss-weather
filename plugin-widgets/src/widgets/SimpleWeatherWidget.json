{
    "$schema": "../../schema.json",
    "name": "SimpleWeatherWidget",
    "displayName": "Simple Weather",
    "description": "Shows current temperature, weather icon, and location",
    "defaultPadding": 6,
    "color": ["case", ["==", ["get", "config.settings.color"], null], "color.onSurface", ["get", "config.settings.color"]],
    "layout": {
        "type": "conditional",
        "condition": ["<", ["get", "size.width"], 120],
        "then": {
            "type": "column",
            "fillWidth": true,
            "fillHeight": true,
            "padding": 3,
            "crossAlignment": "center",
            "children": [
                {
                    "type": "column",
                    "fillWidth": true,
                    "alignment": "center",
                    "crossAlignment": "center",
                    "children": [
                        {
                            "type": "image",
                            "src": ["get", "iconPath"],
                            "size": ["*", ["get", "size.width"], 0.44],
                            "visibleIf": ["has", "iconPath"]
                        },
                        {
                            "type": "label",
                            "text": ["get", "temperature"],
                            "fontSize": ["*", ["get", "size.width"], 0.2],
                            "fontWeight": "bold"
                        }
                    ]
                },
                {
                    "type": "label",
                    "text": ["get", "locationName"],
                    "fontSize": 8,
                    "opacity": 0.5,
                    "maxLines": 1
                }
            ]
        },
        "else": {
            "type": "stack",
            "fillWidth": true,
            "fillHeight": true,
            "paddingHorizontal": ["min", ["*", ["get", "size.width"], 0.05], 10],
            "paddingVertical": ["min", ["*", ["get", "size.height"], 0.07], 6],
            "children": [
                {
                    "type": "label",
                    "text": ["get", "locationName"],
                    "fontSize": 12,
                    "opacity": 0.5,
                    "crossAlignment": "start",
                    "maxLines": 1
                },
                {
                    "type": "row",
                    "fillWidth": true,
                    "fillHeight": true,
                    "alignment": "center",
                    "children": [
                        {
                            "type": "column",
                            "fillHeight": true,
                            "alignment": "center",
                            "crossAlignment": "start",
                            "children": [
                                {
                                    "type": "label",
                                    "text": ["get", "temperature"],
                                    "fontSize": ["min", ["*", ["get", "size.width"], 0.26], 30],
                                    "fontWeight": "bold"
                                }
                            ]
                        },
                        {
                            "type": "column",
                            "fillHeight": true,
                            "flex": 1,
                            "alignment": "center",
                            "crossAlignment": "end",
                            "children": [
                                {
                                    "type": "image",
                                    "src": ["get", "iconPath"],
                                    "size": 64,
                                    "visibleIf": ["has", "iconPath"]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "stack",
                    "fillWidth": true,
                    "fillHeight": true,
                    "alignment": "end",
                    "crossAlignment": "end",
                    "contentAlignment": "BottomEnd",
                    "visibleIf": ["has", "description"],
                    "children": [
                        {
                            "type": "label",
                            "text": ["get", "description"],
                            "fontSize": 12,
                            "opacity": 0.5,
                            "textAlign": "right"
                        }
                    ]
                }
            ]
        }
    },
    "generatePreviews": true,
    "preview": {
        "sizes": [
            { "width": 260, "height": 120 },
            { "width": 50, "height": 50 },
            { "width": 80, "height": 80 },
            { "width": 120, "height": 120 }
        ],
        "fakeData": {
            "temperature": "8\u00b0",
            "iconPath": 800,
            "description": "Partly Cloudy",
            "locationName": "Grenoble",
            "date": "Mon, Feb 24"
        }
    }
}
