                        "fontWeight": ["case", ["==", ["get", "config.settings.clockBold"], true], "bold", "light"],
                        "maxLines": 1
                    },
                    {
                        "type": "row",
                        "children": [
                            {
                                "type": "image",
                                "src": ["get", "iconPath"],
                                "size": ["min", ["*", ["get", "size.width"], 0.22], ["*", ["get", "size.height"], 0.3]],
                                "visibleIf": ["has", "iconPath"]
                            },
                            { "type": "spacer", "size": 3, "direction": "horizontal" },
                            {
                                "type": "label",
                                "text": ["get", "temperature"],
                                "fontSize": ["max", ["min", ["*", ["get", "size.width"], 0.13], ["min", ["*", ["get", "size.height"], 0.15], 15]], 11],
                                "maxLines": 1,
                                "fontWeight": "medium"
                            }
                        ],
                        "crossAlignment": "center"
                    }
                ],
                "fillMaxSize": true,
                "alignment": "center",
                "crossAlignment": "center"
            },
            "else": {
                "type": "conditional",
                "condition": ["<", ["get", "size.width"], 220],
                "then": {
                    "type": "conditional",
                    "condition": ["<", ["get", "size.height"], 130],
                    "then": {
                        "type": "column",
                        "children": [
                            {
                                "type": "clock",
                                "fontSize": ["max", ["min", ["/", ["-", ["get", "size.width"], 24], 4.1], ["min", ["*", ["get", "size.height"], 0.38], 48]], 9],
                                "fontWeight": ["case", ["==", ["get", "config.settings.clockBold"], true], "bold", "light"],
                                "maxLines": 1
                            },
                            {
                                "type": "row",
                                "children": [
                                    {
                                        "type": "date",
                                        "style": "date",
                                        "fontSize": ["max", ["min", ["*", ["get", "size.width"], 0.08], ["min", ["*", ["get", "size.height"], 0.12], 13]], 10],
                                        "maxLines": 1,
                                        "opacity": 0.6,
                                        "flex": 1
                                    },
                                    {
                                        "type": "image",
                                        "src": ["get", "iconPath"],
                                        "size": ["min", ["*", ["get", "size.height"], 0.36], 40],
                                        "visibleIf": ["has", "iconPath"]
                                    },
                                    { "type": "spacer", "size": 3, "direction": "horizontal" },
                                    {
                                        "type": "label",
                                        "text": ["get", "temperature"],
                                        "fontSize": ["max", ["min", ["*", ["get", "size.width"], 0.12], ["min", ["*", ["get", "size.height"], 0.2], 20]], 13],
                                        "maxLines": 1
                                    }
                                ],
                                "fillWidth": true,
                                "crossAlignment": "center"
                            }
                        ],
                        "fillMaxSize": true,
                        "alignment": "center",
                        "paddingHorizontal": 12
                    },
                    "else": {
                        "type": "column",
                        "children": [
                            {
                                "type": "clock",
                                "fontSize": ["max", ["min", ["/", ["-", ["get", "size.width"], 24], 4.1], ["min", ["*", ["get", "size.height"], 0.3], 48]], 9],
                                "fontWeight": ["case", ["==", ["get", "config.settings.clockBold"], true], "bold", "light"],
                                "maxLines": 1
                            },
                            {
                                "type": "date",
                                "style": "date",
                                "fontSize": ["max", ["min", ["*", ["get", "size.width"], 0.09], ["min", ["*", ["get", "size.height"], 0.09], 13]], 10],
                                "maxLines": 1,
                                "opacity": 0.6
                            },
                            { "type": "spacer", "flex": 1 },
                            {
                                "type": "row",
                                "children": [
                                    {
                                        "type": "column",
                                        "children": [
                                            {
                                                "type": "label",
                                                "text": ["get", "temperature"],
                                                "fontSize": ["min", ["*", ["get", "size.width"], 0.15], ["min", ["*", ["get", "size.height"], 0.15], 24]],
                                                "maxLines": 1
                                            },
