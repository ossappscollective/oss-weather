{
    "$schema": "../../schema.json",
    "name": "ForecastWeatherWidget",
    "displayName": "Detailed Forecast",
    "description": "Shows current weather, hourly and daily forecasts",
    "defaultPadding": 0,
    "color": ["case", ["==", ["get", "config.settings.color"], null], "color.onSurface", ["get", "config.settings.color"]],
    "layout": {
        "type": "column",
        "children": [
            {
                "type": "row",
                "children": [
                    {
                        "type": "column",
                        "children": [
                            {
                                "type": "label",
                                "text": ["get", "locationName"],
                                "fontSize": 12,
                                "maxLines": 1,
                                "opacity": 0.6
                            },
                            {
                                "type": "label",
                                "text": ["get", "temperature"],
                                "fontSize": ["min", ["*", ["get", "size.width"], 0.15], ["min", ["*", ["get", "size.height"], 0.15], 50]],
                                "maxLines": 1,
                                "fontWeight": "light"
                            },
                            { "type": "label", "text": ["get", "description"], "fontSize": 14, "maxLines": 1 },
                            {
                                "type": "row",
                                "children": [
                                    {
                                        "type": "label",
                                        "text": ["get", "temperatureLow"],
                                        "fontSize": 14,
                                        "maxLines": 1,
                                        "opacity": 0.6
                                    },
                                    { "type": "spacer", "size": 4, "direction": "horizontal" },
                                    {
                                        "type": "label",
                                        "text": ["get", "temperatureHigh"],
                                        "fontSize": 14,
                                        "maxLines": 1,
                                        "fontWeight": "medium"
                                    }
                                ],
                                "crossAlignment": "center"
                            }
                        ],
                        "flex": 1
                    },
                    {
                        "type": "image",
                        "src": ["get", "iconPath"],
                        "size": ["*", ["min", ["*", ["get", "size.width"], 0.26], ["min", ["*", ["get", "size.height"], 0.26], 80]], 1.3],
                        "visibleIf": ["has", "iconPath"]
                    }
                ],
                "fillWidth": true,
                "crossAlignment": "start"
            },
            { "type": "spacer", "size": 6 },
            {
                "type": "chips",
                "items": "chips",
                "limit": 6,
                "fontSize": 12,
                "iconSize": 14,
                "maxWidth": ["-", ["get", "size.width"], 28],
                "maxRows": 2
            },
            { "type": "spacer", "size": 10 },
            {
                "type": "conditional",
                "condition": [">=", ["get", "size.height"], 380],
                "then": {
                    "type": "column",
                    "children": [{"type": "template", "name": "hourlySection"}, {"type": "spacer", "size": 8}],
                    "fillWidth": true
                },
                "else": { "type": "column", "children": [], "fillWidth": true }
            },
            {
                "type": "forEach",
                "items": "dailyData",
                "limit": [
                    "case",
                    [">=", ["get", "size.height"], 380],
                    [
                        "case",
                        [">=", ["get", "size.height"], 565],
                        6,
                        [">=", ["get", "size.height"], 522],
                        5,
                        [">=", ["get", "size.height"], 479],
                        4,
                        [">=", ["get", "size.height"], 436],
                        3,
                        [">=", ["get", "size.height"], 393],
                        2,
                        1
                    ],
                    [
                        "case",
                        [">=", ["get", "size.height"], 356],
                        4,
                        [">=", ["get", "size.height"], 313],
                        3,
                        [">=", ["get", "size.height"], 270],
                        2,
                        1
                    ]
                ],
                "itemTemplate": { "type": "template", "name": "dailyRow" }
            }
        ],
        "fillMaxSize": true,
        "padding": 14
    },
    "generatePreviews": true,
    "preview": {
        "sizes": [{"width": 320, "height": 320}, {"width": 320, "height": 460}],
        "fakeData": {
            "temperature": "12°",
            "locationName": "Paris",
            "description": "Partly Cloudy",
            "iconPath": 800,
            "date": "Mon, Feb 24",
            "hourlyData": [
                { "time": "06:00", "temperature": "6°", "iconPath": 800, "precipAccumulation": "0 mm" },
                { "time": "07:00", "temperature": "7°", "iconPath": 800, "precipAccumulation": "0 mm" },
                { "time": "08:00", "temperature": "8°", "iconPath": 802, "precipAccumulation": "0 mm" },
                { "time": "09:00", "temperature": "10°", "iconPath": 500, "precipAccumulation": "0 mm" },
                { "time": "10:00", "temperature": "12°", "iconPath": 802, "precipAccumulation": "0 mm" },
                { "time": "11:00", "temperature": "13°", "iconPath": 802, "precipAccumulation": "0 mm" }
            ],
            "dailyData": [
                {
                    "day": "Mon",
                    "iconPath": 800,
                    "temperatureHigh": "12°",
                    "temperatureLow": "4°",
                    "precipAccumulation": "0 mm"
                },
                {
                    "day": "Tue",
                    "iconPath": 802,
                    "temperatureHigh": "14°",
                    "temperatureLow": "6°",
                    "precipAccumulation": "0 mm"
                },
                {
                    "day": "Wed",
                    "iconPath": 500,
                    "temperatureHigh": "10°",
                    "temperatureLow": "5°",
                    "precipAccumulation": "0 mm"
                },
                {
                    "day": "Thu",
                    "iconPath": 802,
                    "temperatureHigh": "9°",
                    "temperatureLow": "3°",
                    "precipAccumulation": "0 mm"
                },
                {
                    "day": "Fri",
                    "iconPath": 800,
                    "temperatureHigh": "11°",
                    "temperatureLow": "4°",
                    "precipAccumulation": "0 mm"
                },
                {
                    "day": "Sat",
                    "iconPath": 803,
                    "temperatureHigh": "15°",
                    "temperatureLow": "7°",
                    "precipAccumulation": "0 mm"
                }
            ]
        }
    }
}
