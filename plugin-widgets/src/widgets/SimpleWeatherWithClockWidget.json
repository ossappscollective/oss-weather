{
    "$schema": "../../schema.json",
    "name": "SimpleWeatherWithClockWidget",
    "displayName": "Weather with Clock",
    "description": "Shows a clock with current weather information",
    "defaultPadding": 0,
    "color": ["case", ["has", ["get", "config.settings.color"]], ["get", "config.settings.color"], "color.onSurface"],
    "settings": {
        "clockBold": { "type": "boolean", "default": false, "title": "bold_clock" },
        "showHourly": { "type": "boolean", "default": false, "title": "widget_show_hourly" }
    },
    "layout": {
        "type": "conditional",
        "condition": ["<", ["get", "size.height"], 70],
        "then": {
            "type": "row",
            "children": [
                {
                    "type": "clock",
                    "fontSize": ["max", ["min", ["/", ["-", ["get", "size.width"], 110], 4.1], ["min", ["*", ["get", "size.height"], 0.55], 34]], 9],
                    "fontWeight": ["case", ["==", ["get", "config.settings.clockBold"], true], "bold", "light"],
                    "maxLines": 1
                },
                { "type": "spacer", "flex": 1 },
                {
                    "type": "image",
                    "src": ["get", "iconPath"],
                    "size": ["min", ["*", ["get", "size.height"], 0.5], 28],
                    "visibleIf": ["has", "iconPath"]
                },
                { "type": "spacer", "size": 4, "direction": "horizontal" },
                {
                    "type": "label",
                    "text": ["get", "temperature"],
